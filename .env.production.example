# LeonidApp — variables de producción. Copia a .env.production (NO se versiona) y rellena.
# Todos los valores de abajo son marcadores: no hay secretos reales en este archivo.

# --- Dominio público (Cloudflare proxied -> https) ---
VITE_API_URL=https://leonidapp.example.com
CLIENT_ORIGIN=https://leonidapp.example.com
PUBLIC_SITE_URL=https://leonidapp.example.com
API_PUBLIC_URL=https://leonidapp.example.com
APP_DEEPLINK=leonidapp://auth/callback

# --- MongoDB Atlas (usuario con permisos solo sobre esta base; allowlist de IP del servidor) ---
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/leonidapp?retryWrites=true&w=majority

# --- Secretos (>= 32 caracteres; genera cada uno con: openssl rand -hex 32) ---
JWT_SECRET=
COOKIE_SECRET=
PIPELINE_INGEST_TOKEN=

# --- Bootstrap: el primer login con este email recibe SUPER_ADMIN ---
SUPER_ADMIN_EMAIL=

# --- OAuth2 + PKCE (maximo 4 accesos) y Magic Link; redirect_uri = API_PUBLIC_URL/api/auth/... ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LeonidApp <no-reply@leonidapp.example.com>

# --- Opcional ---
PIPELINE_WEBHOOK_URL=
