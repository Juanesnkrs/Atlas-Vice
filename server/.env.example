# --- Servidor ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/leonidapp

# --- Secretos (min. 32 caracteres; generar con: openssl rand -hex 32) ---
JWT_SECRET=change-me-change-me-change-me-change-me
COOKIE_SECRET=change-me-change-me-change-me-change-me

# --- Origenes ---
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# URL publica de ESTA API (para redirect_uri de OAuth)
API_PUBLIC_URL=http://localhost:3000
# Retorno a la app nativa tras OAuth (Capacitor, esquema leonidapp://)
APP_DEEPLINK=leonidapp://auth/callback

# --- OAuth2 + PKCE (maximo 4 proveedores: Google, Discord, Apple, Magic Link) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Clave privada .p8 en una sola linea, con \n escapados
APPLE_PRIVATE_KEY=

# --- Magic Link (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LeonidApp <no-reply@example.com>

# --- Bootstrap: el primer login con este email recibe SUPER_ADMIN ---
SUPER_ADMIN_EMAIL=
